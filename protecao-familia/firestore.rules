rules_version = '2';

// Segurança: qualquer usuário autenticado (inclusive anônimo) pode ler/escrever
// dentro de uma família, DESDE QUE conheça o código dela (o ID do documento).
// Não há como o Firestore validar "é o pai de verdade?" sem um servidor próprio —
// a proteção real é o código da família ser longo e aleatório (gerado com ~20
// caracteres) e nunca ser compartilhado em lugar público.
service cloud.firestore {
  match /databases/{database}/documents {
    match /familias/{codigoFamilia} {
      allow read, write: if request.auth != null;

      match /dispositivos/{idDispositivo} {
        allow read, write: if request.auth != null;

        match /historico/{idHistorico} {
          allow read, write: if request.auth != null;
        }
        match /comandos/{idComando} {
          allow read, write: if request.auth != null;
        }
        match /alertas/{idAlerta} {
          allow read, write: if request.auth != null;
        }
      }
    }
  }
}
